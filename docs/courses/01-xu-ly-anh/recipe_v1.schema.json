{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://photo-advisor.local/schemas/recipe_v1.schema.json",
  "title": "Photo Advisor recipe v0 and v1",
  "description": "Recipe contract supporting legacy pipeline_v0 and proposed pipeline_v1. Draft-07 defaults are annotations; runtime validator must materialize v1 defaults.",
  "oneOf": [
    {
      "title": "pipeline_v0",
      "type": "object",
      "required": ["pipeline_version", "exposure", "contrast", "saturation", "crop"],
      "properties": {
        "pipeline_version": {"const": "pipeline_v0"},
        "exposure": {"type": "number", "minimum": -1.5, "maximum": 1.5},
        "contrast": {"type": "number", "minimum": 0.7, "maximum": 1.3, "default": 1.0},
        "saturation": {"type": "number", "minimum": 0.8, "maximum": 1.3, "default": 1.0},
        "crop": {"$ref": "#/definitions/crop"}
      },
      "additionalProperties": false
    },
    {
      "title": "pipeline_v1",
      "type": "object",
      "required": ["pipeline_version", "exposure", "contrast", "saturation", "crop"],
      "properties": {
        "pipeline_version": {"const": "pipeline_v1"},
        "exposure": {"type": "number", "minimum": -1.5, "maximum": 1.5, "default": 0.0},
        "contrast": {"type": "number", "minimum": 0.7, "maximum": 1.3, "default": 1.0},
        "saturation": {"type": "number", "minimum": 0.8, "maximum": 1.3, "default": 1.0},
        "crop": {"$ref": "#/definitions/crop"},
        "temperature": {"type": "number", "minimum": -1.0, "maximum": 1.0, "default": 0.0},
        "tint": {"type": "number", "minimum": -1.0, "maximum": 1.0, "default": 0.0},
        "shadows": {"type": "number", "minimum": -0.5, "maximum": 0.5, "default": 0.0},
        "highlights": {"type": "number", "minimum": -0.5, "maximum": 0.5, "default": 0.0},
        "sharpen": {"type": "number", "minimum": 0.0, "maximum": 1.0, "default": 0.0},
        "straighten_deg": {"type": "number", "minimum": -5.0, "maximum": 5.0, "default": 0.0},
        "local": {"const": null, "default": null, "description": "Reserved; non-null local edits are rejected until their contract is approved."}
      },
      "additionalProperties": false
    }
  ],
  "definitions": {
    "crop": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "array",
          "items": {"type": "number", "minimum": 0.0, "maximum": 1.0},
          "minItems": 4,
          "maxItems": 4,
          "description": "[ymin, xmin, ymax, xmax]; runtime additionally requires ymin < ymax and xmin < xmax, minimum 30% retained area and dimension checks."
        }
      ],
      "default": null
    }
  }
}
